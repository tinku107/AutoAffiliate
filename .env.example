# ==============================================================================
# AutoAffiliate AI - Environment Secrets Template (.env.example)
# Copy this file to '.env' and fill in your actual credentials.
# ==============================================================================

# Meta Graph API (Instagram & Facebook Publishing)
# Obtain from https://developers.facebook.com/tools/explorer/
META_ACCESS_TOKEN=
META_USER_TOKEN=
META_PAGE_ID=
INSTAGRAM_ACCOUNT_ID=
INSTAGRAM_USERNAME=

# Affiliate Tracking Credentials
# Amazon Associates: https://affiliate-program.amazon.in/
AMAZON_ASSOCIATE_TAG=your_tag-21
# EarnKaro Referral: https://earnkaro.com/
EARNKARO_API_KEY=
EARNKARO_USER_ID=

# AI Model Keys (Optional - uses built-in heuristic humanoid generator when empty)
GEMINI_API_KEY=

# Telegram Channel Deals Broadcasting (Optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=
